# 示例环境变量文件。复制为 .env.local 或在 CI 中注入真实值。
# 天地图 API Key（必填）：在生产/构建环境中设置真实 key
VUE_APP_TIANDITU_KEY=YOUR_TIANDITU_KEY_HERE

# 数据源: auto | api | static
VUE_APP_DATA_SOURCE=auto

# 是否在前端使用后端瓦片代理（true/false）
VUE_APP_USE_TILE_PROXY=false

# 服务端私有天地图 key（用于代理，不会打包到前端）
# 在服务器或 CI 环境中设置 `TIANDITU_KEY` 或 `SERVER_TIANDITU_KEY`。
TIANDITU_KEY=

# 本地开发时后端代理（如果需要）
VUE_APP_API_PROXY_TARGET=http://localhost:3100

# 部署子路径示例（若部署到子路径，请设置，例如 /myapp/）
PUBLIC_PATH=/
